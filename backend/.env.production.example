# Production Environment Configuration Example
# Copy this to .env on your production server and update the values

APP_NAME="Elmino Educational Platform"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=http://195.177.255.8
FRONTEND_URL=http://195.177.255.8
APP_TIMEZONE=Asia/Tehran
APP_VERSION=1.0.0

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

APP_API_RATE=60

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration - Update with your production database credentials
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elmino_production
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# IMPORTANT: Add your production frontend URL here for CORS
SANCTUM_STATEFUL_DOMAINS=195.177.255.8,localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration - Update with your production mail settings
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@elmino.ir"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OTP Configuration
OTP_TTL=120
OTP_LENGTH=6
OTP_REQUEST_LIMIT=3
OTP_VERIFY_LIMIT=5
OTP_WINDOW=300
OTP_DRIVER=kavenegar  # Change to your SMS provider

# SpotPlayer Configuration
SPOTPLAYER_API_KEY=your_production_api_key
SPOTPLAYER_LEVEL=-1
SPOTPLAYER_BASE_URL=https://panel.spotplayer.ir
SPOTPLAYER_LICENSE_ENDPOINT=/license/edit/
SPOTPLAYER_TEST=false
SPOTPLAYER_TIMEOUT=15
SPOTPLAYER_CONNECT_TIMEOUT=5
SPOTPLAYER_MAX_TRIES=6
