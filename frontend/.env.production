# Production Environment Configuration
# 
# IMPORTANT: Update VITE_API_BASE_URL based on your server setup:
#
# Option 1: Reverse proxy (recommended)
#   - Frontend and backend served from same domain via nginx/apache
#   - Use: VITE_API_BASE_URL=/api
#   - Example: http://yourdomain.com -> frontend, http://yourdomain.com/api -> backend
#
# Option 2: Separate servers
#   - Frontend and backend on different ports/domains
#   - Use: VITE_API_BASE_URL=http://YOUR_IP:8000/api
#   - Example: http://195.177.255.8/api
#   - Don't forget to update backend CORS in backend/.env: FRONTEND_URL=http://YOUR_IP
#
# Current setup assumes reverse proxy on port 80
VITE_API_BASE_URL=http://195.177.255.8/api
VITE_USE_MOCK=false
VITE_AUTH_TOKEN_KEY=elmino_access_token
VITE_PERSIST_ACCESS_TOKEN=true