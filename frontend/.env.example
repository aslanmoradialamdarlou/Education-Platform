# Copy this file to `.env.local` and adjust values for your environment.
# Vite exposes only variables prefixed with VITE_ to the client bundle.

# Base URL of your backend API (no trailing slash). Example for local dev:
VITE_API_BASE_URL=http://localhost:8000/api

# Toggle mock data usage. Set to 'false' to use real API endpoints when implemented.
VITE_USE_MOCK=false

# Optional: token storage key override (leave empty to use default)
VITE_AUTH_TOKEN_KEY=elmino_access_token

VITE_PERSIST_ACCESS_TOKEN=true